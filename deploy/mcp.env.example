# /etc/mcp-optima-bd/mcp.env  (0600, root:mcp) — NO versionar con valores reales.
#
# OJO al mapeo en el host de la réplica (standby):
#   MYSQL_HOST         = PRIMARIO (10.0.0.5)  -> solo fallback y réplica lo lee por binlog
#   MYSQL_REPLICA_HOST = RÉPLICA LOCAL (127.0.0.1) -> destino normal de lectura
# Así el router lee local y solo cae al primario si el lag supera el umbral.

MYSQL_HOST=10.0.0.5
MYSQL_PORT=3306
MYSQL_DB=back
MYSQL_USER=back_readonly
MYSQL_PASSWORD=<PASSWORD>

MYSQL_REPLICA_HOST=127.0.0.1
MYSQL_REPLICA_PORT=3306
MYSQL_REPLICA_USER=back_readonly
MYSQL_REPLICA_PASSWORD=<PASSWORD>
MYSQL_REPLICA_LAG_MAX_S=60

# En el servidor no hay clave SSH ni debe haberla: el túnel se desactiva.
TUNNEL_ENABLED=0

# --- ciclo de vida de conexiones (multiusuario) -----------------------------
# El pool CLÁSICO (`MYSQL_POOL_SIZE`) retiene sus conexiones hasta el
# wait_timeout de MySQL: con 4 fijas el MCP se queda el cupo del usuario MySQL
# aunque nadie consulte y el resto recibe ERROR 1203. En el servicio se usa el
# pool multiusuario de abajo y `MYSQL_POOL_SIZE` se deja en 0.
MYSQL_POOL_SIZE=0
# Tope de sesiones VIVAS POR EJECUTOR (en uso + ociosas). Con
# MYSQL_REPLICA_HOST definido hay DOS ejecutores (primario y réplica), así que
# el presupuesto total es: este número × 2 × nº de workers de uvicorn.
# 4 → 8 sesiones en total con réplica; 0 en reposo pasados ~60 s (+≤5 s de barrido).
MYSQL_POOL_MAX=4
# Cierre por inactividad: una sesión ociosa se cierra a los 60 s. Es lo que
# devuelve el cupo a los humanos.
MYSQL_POOL_IDLE_S=60
# Cupo por API key y por ejecutor: una persona con queries lentas no deja sin
# conexión al resto.
MYSQL_POOL_MAX_PER_KEY=2
# Espera máxima por un hueco antes de devolver un error accionable.
MYSQL_POOL_WAIT_S=10
# Tope de filas materializadas. 50.000 filas anchas pueden agotar MemoryMax=512M
# y tumbar el servicio para todos; 10.000 es un techo razonable en el servicio.
MYSQL_MAX_ROWS=10000

MYSQL_CONNECT_TIMEOUT_S=5
MYSQL_READ_TIMEOUT_S=20
MYSQL_QUERY_TIMEOUT_MS=15000
MYSQL_SLOW_QUERY_MS=5000

MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8443
MCP_ALLOWED_HOSTS=mcp-back.optimaonline.eu,127.0.0.1:8443,localhost:8443
MCP_API_KEYS_DB=/var/lib/mcp-optima-bd/api_keys.db
# Rate limit in-memory por PROCESO (http_app.py): con un solo worker uvicorn
# (como está desplegado hoy) el límite real es este valor. Si algún día se
# escala a varios workers/réplicas, el límite efectivo se multiplica por el
# nº de procesos — revisar entonces si hace falta un backend compartido
# (Redis) en vez de la ventana deslizante en memoria.
MCP_RATE_LIMIT_PER_MIN=120
# Fallos de autenticación por cliente (peer + keyid) y minuto antes de 429. Sin
# esto, el 401 se comprobaba antes del rate limit: una clave inválida podía
# martillear el endpoint (lookup SQLite + sha256 por petición) sin gastar
# presupuesto. Se cuenta por cliente y no por IP porque detrás de nginx/túnel el
# peer es siempre 127.0.0.1: una ventana por IP dejaría a todos con 429.
MCP_AUTH_FAIL_PER_MIN=30

# run_script ejecuta Python del cliente con exec() y builtins recortados, que
# NO son un sandbox (se llega a `os` por el grafo de objetos). Sin definir la
# variable, en HTTP la tool NO se registra (fail-closed) y el cliente recibe
# 'Unknown tool'. Poner 1 solo si se acepta ese riesgo de forma consciente.
# MCP_ENABLE_RUN_SCRIPT=1
DATA_DIR=/var/lib/mcp-optima-bd

# Deliberadamente SIN FIJAR: MCP_TOOL_PROFILE=contabilidad|operaciones|excel
# reduce tools/list de ~4.000 a ~1.000-2.000 tokens por sesión (ver
# perfiles.py), pero esta cuenta consulta finanzas Y operaciones (OT) en la
# misma sesión — forzar un perfil de dominio le rompería la mitad de los
# casos de uso reales. Solo activar si se crea una API key dedicada a un uso
# de un único dominio.

# Tools de Excel: en HTTP el .xlsx viaja en `contenido_b64` y se procesa en
# memoria (no se escribe nada en disco). MCP_FILES_DIR es OPCIONAL: solo si
# además quieres permitir leer ficheros ya subidos a ese directorio.
MCP_FILES_DIR=
