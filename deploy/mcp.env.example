# /etc/mcp-optima-bd/mcp.env  (0600, root:mcp) — NO versionar con valores reales.
#
# OJO al mapeo en el host de la réplica (standby):
#   MYSQL_HOST         = PRIMARIO (10.0.0.5)  -> solo fallback y réplica lo lee por binlog
#   MYSQL_REPLICA_HOST = RÉPLICA LOCAL (127.0.0.1) -> destino normal de lectura
# Así el router lee local y solo cae al primario si el lag supera el umbral.

MYSQL_HOST=10.0.0.5
MYSQL_PORT=3306
MYSQL_DB=back
MYSQL_USER=back_readonly
MYSQL_PASSWORD=<PASSWORD>

MYSQL_REPLICA_HOST=127.0.0.1
MYSQL_REPLICA_PORT=3306
MYSQL_REPLICA_USER=back_readonly
MYSQL_REPLICA_PASSWORD=<PASSWORD>
MYSQL_REPLICA_LAG_MAX_S=60

# En el servidor no hay clave SSH ni debe haberla: el túnel se desactiva.
TUNNEL_ENABLED=0
MYSQL_POOL_SIZE=4
MYSQL_CONNECT_TIMEOUT_S=5
MYSQL_READ_TIMEOUT_S=20
MYSQL_QUERY_TIMEOUT_MS=15000
MYSQL_SLOW_QUERY_MS=5000

MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8443
MCP_ALLOWED_HOSTS=mcp-back.optimaonline.eu,127.0.0.1:8443,localhost:8443
MCP_API_KEYS_DB=/var/lib/mcp-optima-bd/api_keys.db
MCP_RATE_LIMIT_PER_MIN=120
DATA_DIR=/var/lib/mcp-optima-bd

# Tools de Excel: en HTTP el .xlsx viaja en `contenido_b64` y se procesa en
# memoria (no se escribe nada en disco). MCP_FILES_DIR es OPCIONAL: solo si
# además quieres permitir leer ficheros ya subidos a ese directorio.
MCP_FILES_DIR=
