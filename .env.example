# Copy to ~/.zt-readonly.env (NOT committed). Source into agent env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DB=back
MYSQL_USER=back_readonly
MYSQL_PASSWORD=CHANGE_ME
DATA_DIR=./data
# Timeout server-side de SELECT (ms) — MySQL mata la query a los 15s (default).
MYSQL_QUERY_TIMEOUT_MS=15000
# Umbral (ms) para registrar queries lentas en data/slow_queries.jsonl (default).
MYSQL_SLOW_QUERY_MS=5000